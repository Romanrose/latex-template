%% Article / course-note profile.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mi-note}[2026/08/04 Note output profile]

\RequirePackage[a4paper,margin=25mm]{geometry}
\RequirePackage{fancyhdr,titlesec}
\linespread{1.28}
\numberwithin{equation}{section}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\textcolor{MIBrand}{\thepage}}
\renewcommand{\headrulewidth}{0pt}
\titleformat{\section}{\Large\bfseries\color{MIDark}}{\thesection}{.6em}{}
\titleformat{\subsection}{\large\bfseries\color{MIBrand}}{\thesubsection}{.6em}{}
